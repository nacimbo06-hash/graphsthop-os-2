# IGO Desktop Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# API Configuration
# ============================================
# Base URL for the backend API
VITE_API_BASE_URL=http://localhost:3000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Enable mock mode for development (true/false)
VITE_MOCK_MODE=false

# ============================================
# Application Configuration
# ============================================
# Application name
VITE_APP_NAME=IGO Desktop

# Application version
VITE_APP_VERSION=1.0.0

# Environment (development/production)
VITE_NODE_ENV=development

# ============================================
# Security Configuration
# ============================================
# Encryption key for secure storage (generate a strong key)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_KEY=

# JWT token expiration time in minutes
VITE_TOKEN_EXPIRY=60

# ============================================
# Feature Flags
# ============================================
# Enable analytics
VITE_ENABLE_ANALYTICS=false

# Enable auto-update
VITE_ENABLE_AUTO_UPDATE=true

# ============================================
# Logging Configuration
# ============================================
# Log level (debug/info/warn/error)
VITE_LOG_LEVEL=info

# Enable detailed logging
VITE_DEBUG_MODE=false

# ============================================
# Database Configuration (Tauri SQLite)
# ============================================
# Database name
VITE_DB_NAME=igo-desktop.db

# Enable database debugging
VITE_DB_DEBUG=false

# ============================================
# Printer Configuration
# ============================================
# Default printer name (optional)
VITE_DEFAULT_PRINTER=

# Thermal printer width in mm
VITE_PRINTER_WIDTH=80

# ============================================
# Receipt Configuration
# ============================================
# Company name on receipts
VITE_RECEIPT_COMPANY_NAME=

# Company address on receipts
VITE_RECEIPT_COMPANY_ADDRESS=

# Company phone on receipts
VITE_RECEIPT_COMPANY_PHONE=

# Receipt footer message
VITE_RECEIPT_FOOTER=Merci de votre visite!
