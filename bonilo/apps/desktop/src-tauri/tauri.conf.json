{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bonilo",
  "version": "1.0.0",
  "identifier": "com.bonilo.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bonilo POS",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Bonilo POS — Neighborhood Grocery OS",
    "longDescription": "Bonilo est un système de gestion de point de vente complet pour les supermarchés de quartier. Gestion des stocks, caisse rapide, trésorerie et rapports intelligents.",
    "copyright": "© 2026 Bonilo",
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:bonilo.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwNzhDNDkwNzA0Mjg5MzcKUldRM2lVSndrTVI0Z0tGTUMyZTNZbWFYY3o0YUpHRXRrTkhEdGsxbTdzOEdEeVNON092RjhUTkUK",
      "endpoints": [
        "https://github.com/nacimbo06-hash/graphsthop-os-2/releases/latest/download/latest.json"
      ]
    }
  }
}